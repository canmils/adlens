HOST=127.0.0.1
PORT=3000
# Set a strong token for any remote installation. The UI asks for this token.
APP_TOKEN=
# Required only for AI analysis, never used by browser capture.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
MAX_ANALYSES_PER_DAY=50
# For a remote UI, set its exact HTTPS origin. No wildcard origins.
ALLOWED_ORIGIN=
